# AnimeVideo AI - Secure Environment Variables Configuration
# Configure these variables securely in the Secrets panel in Google AI Studio or in your .env file.
# NEVER hardcode API keys directly into source code.

# ----------------------------------------------------
# 1. VIDEO GENERATION PROVIDER
# ----------------------------------------------------
# Supported providers: replicate, minimax, fal, gemini
VIDEO_PROVIDER=replicate

# VIDEO_API_KEY: Your API token/key for the video generation provider (e.g., r8_... for Replicate)
VIDEO_API_KEY=your_video_api_key_here

# VIDEO_MODEL: Target video model (e.g. "wan-video/wan-2.1-t2v-480p", "minimax/video-01", "lucataco/animate-diff")
VIDEO_MODEL=wan-video/wan-2.1-t2v-480p

# REPLICATE_API_TOKEN: Dedicated Replicate token alias
REPLICATE_API_TOKEN=r8_your_replicate_token_here

# ----------------------------------------------------
# 2. TTS & NARRATION VOICE PROVIDER
# ----------------------------------------------------
# Supported providers: system-tts, sarvam, elevenlabs, replicate-bark
TTS_PROVIDER=system-tts

# TTS_API_KEY: API key for external TTS providers (Sarvam AI / ElevenLabs)
TTS_API_KEY=your_tts_api_key_here

# TTS_MODEL: TTS model identifier
TTS_MODEL=hindi-english-neural-v1

# Optional legacy keys
HINDI_VOICE_API_KEY=your_voice_api_key_here

# GEMINI_API_KEY: For AI script decomposition and prompt optimization
# GEMINI_API_KEY=MY_GEMINI_API_KEY
